<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <!-- Email credentials live in smtp.secrets.config, which is not committed to git.
         If that file is missing the program still works, it just skips the emails. -->
    <appSettings file="smtp.secrets.config" />
</configuration>