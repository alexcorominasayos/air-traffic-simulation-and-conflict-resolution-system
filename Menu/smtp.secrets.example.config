<?xml version="1.0" encoding="utf-8" ?>
<!--
  Copy this file to "smtp.secrets.config" (same folder) and fill in the Gmail account used to
  send account notifications. Use a Gmail "app password", never the account's real password.
  smtp.secrets.config is listed in .gitignore so the password is never committed.
-->
<appSettings>
  <add key="SmtpSenderAddress" value="your.account@gmail.com" />
  <add key="SmtpSenderPassword" value="your app password" />
</appSettings>
