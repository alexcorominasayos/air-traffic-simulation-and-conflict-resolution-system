<Window x:Class="Videogame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Videogame"
        mc:Ignorable="d"
        Title="Videogame" Height="490" Width="525" FocusManager.FocusedElement="{Binding ElementName=GameCanvas}" KeyDown="HandleKeyDown" KeyUp="HandleKeyUp">
    <Canvas Name="GameCanvas" Focusable="True">
        <Canvas.Background>
            <ImageBrush ImageSource="Imagenes/starsbackground.jpg"></ImageBrush>
        </Canvas.Background>

        <Image Height="145" Width="200" Source="Imagenes/clouds.png" Canvas.Left="60" Canvas.Top="20" Tag="clouds" Opacity="0.5"/>
        <Image Height="145" Width="200" Source="Imagenes/clouds2.png" Canvas.Left="300" Canvas.Top="96" Tag="clouds" Opacity="0.5"/>

        <Image Height="390" Width="66" Source="Imagenes/pipeBottomGray.png"  Canvas.Left="60" Canvas.Top="204" Tag="obstacle1"/>
        <Image Height="390" Width="66" Source="Imagenes/pipeTopGray.png" Canvas.Left="60" Canvas.Top="-320" Tag="obstacle1"/>

        <Image Height="390" Width="66" Source="Imagenes/pipeBottomGray.png"  Canvas.Left="233" Canvas.Top="364" Tag="obstacle2"/>
        <Image Height="390" Width="66" Source="Imagenes/pipeTopGray.png" Canvas.Left="233" Canvas.Top="-160" Tag="obstacle2"/>

        <Image Height="389" Width="75" Source="Imagenes/pipeBottomGray.png"  Canvas.Left="433" Canvas.Top="296" Tag="obstacle3"/>
        <Image Height="387" Width="66" Source="Imagenes/pipeTopGray.png" Canvas.Left="433" Canvas.Top="-228" Tag="obstacle3"/>

        <Label Name="ScoreLabel" FontSize="22" FontWeight="ExtraBold" Content="Score: 0/10" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Width="524"/>
        <Image Stretch="Fill" Name="JetImage" Height="36" Width="80" Source="Imagenes/jet.png" Canvas.Left="34" Canvas.Top="149" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Label x:Name="CountdownLabel" FontSize="72" FontWeight="ExtraBold" Content="5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Left="239" Canvas.Top="220"/>
        <Label x:Name="InstructionsLabel" FontSize="24" FontWeight="ExtraBold" Content="Press R to restart and C to close" Foreground="White" Canvas.Left="70" Canvas.Top="305" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label x:Name="RestartLabel" Content="R - Restart" Foreground="White" Canvas.Left="444" Canvas.Top="417" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
        <Label x:Name="CloseLabel" Content="C - Close" Foreground="White" Canvas.Left="444" Canvas.Top="430" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Label x:Name="ResultLabel" FontSize="48" FontWeight="ExtraBold" Content="GAME OVER !!" Foreground="White" Canvas.Left="89" Canvas.Top="200" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Canvas>
</Window>